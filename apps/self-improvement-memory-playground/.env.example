# Optional. Used only when the UI model mode is "Real".
# Copy to .env. Never commit .env.
SIM_API_KEY=
# OpenAI-compatible base URL. Defaults to https://api.openai.com/v1
SIM_API_BASE=https://api.openai.com/v1
# Chat model id. Defaults to gpt-4o-mini
SIM_MODEL=gpt-4o-mini

# OPENAI_API_KEY is used if SIM_API_KEY is empty.
# OPENAI_API_KEY=
